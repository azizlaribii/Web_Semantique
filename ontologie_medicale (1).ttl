                       :Toux ;
        :estTraiteePar :Amx ,
                       :Doliprane ;
        :description "Infection de la gorge causee par des bacteries ou des virus."@fr ;
        :dureeTraitement "7 jours" ;
        :estContagieuse "true"^^xsd:boolean ;
        :gravite "moderee"@fr ;
        rdfs:label "Angine"@fr .


