med:aConsulte a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "a consulté"@fr ;
    rdfs:comment "Relation transitive : A a consulté B qui a consulté C → A a consulté C."@fr ;
    rdfs:domain med:Personne ;
    rdfs:range med:Personne .

med:aPourSymptome a owl:ObjectProperty ;
    rdfs:label "a pour symptôme"@fr ;
    rdfs:comment "Une maladie se manifeste par un ou plusieurs symptômes."@fr ;
    rdfs:domain med:Maladie ;
    rdfs:range med:Symptome ;
    owl:inverseOf med:estSymptomeDe .

med:a_lieu_dans a owl:ObjectProperty ;
    rdfs:domain med:Consultation ;
    rdfs:range med:Dossier_patient .

med:adresse a owl:DatatypeProperty ;
    rdfs:label "adresse"@fr ;
    rdfs:domain med:Personne ;
    rdfs:range xsd:string .

med:age a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "âge"@fr ;
    rdfs:comment "Âge de la personne (entier, fonctionnel)."@fr ;
    rdfs:domain med:Personne ;
    rdfs:range xsd:integer .

med:appartient_à a owl:ObjectProperty ;
    rdfs:domain med:Medecin .

med:capacité a owl:DatatypeProperty ;
    rdfs:domain med:Dossier_patient ;
    rdfs:range xsd:integer .

med:chefs_de_service a owl:Class ;
    rdfs:subClassOf med:Stuff_Médicale .

med:concerne a owl:ObjectProperty ;
    rdfs:domain med:Consultation ;
    rdfs:range med:Maladie .

med:concerneMaladie a owl:ObjectProperty ;
    rdfs:label "concerne maladie"@fr ;
    rdfs:comment "Une maladie est concernée par une ordonnance. Inverse : estPrescritePour."@fr ;
    rdfs:domain med:Maladie ;
    rdfs:range med:Ordonnance ;
    owl:inverseOf med:estPrescritePour .

med:connait a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "connaît"@fr ;
    rdfs:comment "Relation symétrique : si A connaît B, alors B connaît A."@fr ;
    rdfs:domain med:Personne ;
    rdfs:range med:Personne .

med:contient a owl:ObjectProperty ;
    rdfs:domain med:Ordonnance ;
    rdfs:range med:Medicament .

med:contientMedicament a owl:ObjectProperty ;
    rdfs:label "contient (médicament)"@fr ;
    rdfs:domain med:Ordonnance ;
    rdfs:range med:Medicament .

med:contientMolecule a owl:ObjectProperty ;
    rdfs:label "contient (molécule)"@fr ;
    rdfs:comment "Un médicament contient des molécules ; la molécule est elle-même une sous-classe de Médicament."@fr ;
    rdfs:domain med:Medicament ;
    rdfs:range med:Molecule .

med:covid a med:Maladie,
        owl:NamedIndividual ;
    rdfs:label "covid" .

med:dateConsultation a owl:DatatypeProperty ;
    rdfs:label "date de la consultation"@fr ;
    rdfs:range xsd:date .

med:dateNaissance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "date de naissance"@fr ;
    rdfs:domain med:Personne ;
