med:Gastrite a med:Maladie,
        med:MaladieDigestive,
        owl:NamedIndividual ;
    rdfs:label "Gastrite"@fr ;
    med:aPourSymptome med:Douleur_Abdominale,
        med:Nausee,
        med:Vomissement_Symp ;
    med:description "Inflammation de la muqueuse gastrique."@fr ;
    med:dureeTraitement "2 a 4 semaines" ;
    med:estContagieuse false ;
    med:estTraiteePar med:Omeprazole,
        med:Ranitidine ;
    med:gravite "legere"@fr .

