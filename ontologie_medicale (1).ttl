ns1:ordonnance a owl:DatatypeProperty ;
    rdfs:domain med:Ordonnance ;
    rdfs:range xsd:date .

med:description a owl:DatatypeProperty ;
    rdfs:domain med:Maladie ;
    rdfs:range rdf:langString .

med:descriptionSymptome a owl:DatatypeProperty .

med:diagnostique a owl:ObjectProperty ;
    rdfs:label "diagnostique"@fr ;
    rdfs:domain med:Medecin ;
    rdfs:range med:Maladie .

med:dureeTraitement a owl:DatatypeProperty ;
    rdfs:label "duree du traitement"@fr ;
    rdfs:domain med:Maladie ;
    rdfs:range xsd:string .

med:durée a owl:DatatypeProperty ;
    rdfs:domain med:Opération ;
    rdfs:range xsd:integer .

med:durée_de_validité a owl:DatatypeProperty ;
    rdfs:domain med:Ordonnance ;
    rdfs:range xsd:integer .

med:email a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "e-mail"@fr ;
    rdfs:domain med:Personne ;
    rdfs:range xsd:string .

med:estContagieuse a owl:DatatypeProperty ;
    rdfs:domain med:Maladie ;
    rdfs:range xsd:boolean .

med:estContreIndiquePour a owl:ObjectProperty ;
    rdfs:label "est contre-indiqué pour"@fr ;
    rdfs:domain med:Medicament ;
    rdfs:range med:Maladie .

med:estDestineeA a owl:ObjectProperty ;
    rdfs:label "est destinée à"@fr ;
    rdfs:domain med:Ordonnance ;
    rdfs:range med:Patient .

med:estNecessairePour a owl:ObjectProperty ;
    rdfs:label "est nécessaire pour"@fr ;
    rdfs:comment "Une opération est nécessaire pour traiter une maladie. Inverse : necessite."@fr ;
    rdfs:domain med:Opération ;
    rdfs:range med:Maladie ;
    owl:inverseOf med:necessite .

med:estPrisEnChargePar a owl:AnnotationProperty .

med:estRealiseePar a owl:ObjectProperty ;
    rdfs:label "est réalisée par"@fr ;
    rdfs:range med:Medecin ;
    owl:inverseOf med:realise .

med:estSoignePar a owl:ObjectProperty ;
    rdfs:label "est soigné par"@fr ;
    rdfs:comment "Un patient est soigné par un médecin. Inverse : soigne."@fr ;
    rdfs:domain med:Patient ;
    rdfs:range med:Medecin ;
    owl:inverseOf med:soigne .

med:estTraiteePar a owl:ObjectProperty ;
    rdfs:label "est traitée par"@fr ;
    rdfs:comment "Une maladie est traitée par un médicament."@fr ;
    rdfs:domain med:Maladie ;
    rdfs:range med:Medicament ;
    owl:inverseOf med:traite .

med:est_destinée_à a owl:ObjectProperty ;
    rdfs:domain med:Medecin ;
    rdfs:range med:Patient .

med:est_effectuée_par a owl:ObjectProperty ;
    rdfs:domain med:Opération ;
    rdfs:range med:Medecin .

med:est_pris_en_charge_par a owl:ObjectProperty ;
    rdfs:domain med:Patient .

med:est_urgent a owl:DatatypeProperty ;
    rdfs:domain med:Opération ;
    rdfs:range xsd:boolean .

