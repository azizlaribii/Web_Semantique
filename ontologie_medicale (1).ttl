                                                                owl:someValuesFrom xsd:string
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                   rdfs:comment "Classe definie: Patient qui possede un numero de dossier."@fr ;
                   rdfs:label "Patient enregistre"@fr .


