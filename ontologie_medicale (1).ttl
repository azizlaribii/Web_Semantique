###  http://example.org/ontologie-medicale#Anemie
:Anemie rdf:type owl:NamedIndividual ,
                 :MaladieChronique ;
        :aPourSymptome :Essoufflement ,
                       :Fatigue ,
                       :Paleur ;
        :estTraiteePar :Acide_Folique ,
                       :Fer_Sulfate ;
        :description "Diminution du taux d hemoglobine dans le sang."@fr ;
        :dureeTraitement "3 a 6 mois" ;
        :estContagieuse "false"^^xsd:boolean ;
        :gravite "moderee"@fr ;
        :nom "Anemie1234" ;
        rdfs:label "Anemie1234"@fr ,
                   "Anemie1234" .


###  http://example.org/ontologie-medicale#Angine
