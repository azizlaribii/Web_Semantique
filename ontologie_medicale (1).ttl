@prefix : <http://example.org/ontologie-medicale#> .
@prefix ns1: <http://example.org/ontologie-medicale#date_de_l’> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/ontologie-medicale#> .

<http://example.org/ontologie-medicale> rdf:type owl:Ontology ;
                                         rdfs:comment "Ontologie en 3 niveaux de hiérarchie (classe > sous-classe > sous-sous-classe)."@fr ;
                                         rdfs:label "Ontologie médicale : médecin, patient, ordonnance"@fr .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/ontologie-medicale#estPrisEnChargePar
:estPrisEnChargePar rdf:type owl:AnnotationProperty .


###  http://example.org/ontologie-medicale#motDePasse
:motDePasse rdf:type owl:AnnotationProperty .


###  http://example.org/ontologie-medicale#telephone
:telephone rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/ontologie-medicale#aConsulte
:aConsulte rdf:type owl:ObjectProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Personne ;
           rdfs:range :Personne ;
           rdfs:comment "Relation transitive : A a consulté B qui a consulté C → A a consulté C."@fr ;
           rdfs:label "a consulté"@fr .


###  http://example.org/ontologie-medicale#aPourSymptome
:aPourSymptome rdf:type owl:ObjectProperty ;
               owl:inverseOf :estSymptomeDe ;
               rdfs:domain :Maladie ;
               rdfs:range :Symptome ;
               rdfs:comment "Une maladie se manifeste par un ou plusieurs symptômes."@fr ;
               rdfs:label "a pour symptôme"@fr .


###  http://example.org/ontologie-medicale#a_lieu_dans
:a_lieu_dans rdf:type owl:ObjectProperty ;
             rdfs:domain :Consultation ;
             rdfs:range :Dossier_patient .


###  http://example.org/ontologie-medicale#appartient_à
:appartient_à rdf:type owl:ObjectProperty ;
              rdfs:domain :Medecin .


###  http://example.org/ontologie-medicale#concerne
:concerne rdf:type owl:ObjectProperty ;
          rdfs:domain :Consultation ;
          rdfs:range :Maladie .


###  http://example.org/ontologie-medicale#concerneMaladie
:concerneMaladie rdf:type owl:ObjectProperty ;
                 owl:inverseOf :estPrescritePour ;
                 rdfs:domain :Maladie ;
                 rdfs:range :Ordonnance ;
                 rdfs:comment "Une maladie est concernée par une ordonnance. Inverse : estPrescritePour."@fr ;
                 rdfs:label "concerne maladie"@fr .


###  http://example.org/ontologie-medicale#connait
:connait rdf:type owl:ObjectProperty ,
                  owl:SymmetricProperty ;
         rdfs:domain :Personne ;
         rdfs:range :Personne ;
         rdfs:comment "Relation symétrique : si A connaît B, alors B connaît A."@fr ;
         rdfs:label "connaît"@fr .


###  http://example.org/ontologie-medicale#contient
:contient rdf:type owl:ObjectProperty ;
          rdfs:domain :Ordonnance ;
          rdfs:range :Medicament .


###  http://example.org/ontologie-medicale#contientMedicament
:contientMedicament rdf:type owl:ObjectProperty ;
                    rdfs:domain :Ordonnance ;
                    rdfs:range :Medicament ;
                    rdfs:label "contient (médicament)"@fr .


###  http://example.org/ontologie-medicale#contientMolecule
:contientMolecule rdf:type owl:ObjectProperty ;
                  rdfs:domain :Medicament ;
                  rdfs:range :Molecule ;
                  rdfs:comment "Un médicament contient des molécules ; la molécule est elle-même une sous-classe de Médicament."@fr ;
                  rdfs:label "contient (molécule)"@fr .


###  http://example.org/ontologie-medicale#diagnostique
:diagnostique rdf:type owl:ObjectProperty ;
              rdfs:domain :Medecin ;
              rdfs:range :Maladie ;
              rdfs:label "diagnostique"@fr .


###  http://example.org/ontologie-medicale#estContreIndiquePour
:estContreIndiquePour rdf:type owl:ObjectProperty ;
                      rdfs:domain :Medicament ;
                      rdfs:range :Maladie ;
                      rdfs:label "est contre-indiqué pour"@fr .


###  http://example.org/ontologie-medicale#estDestineeA
:estDestineeA rdf:type owl:ObjectProperty ;
              rdfs:domain :Ordonnance ;
              rdfs:range :Patient ;
              rdfs:label "est destinée à"@fr .


###  http://example.org/ontologie-medicale#estNecessairePour
:estNecessairePour rdf:type owl:ObjectProperty ;
                   owl:inverseOf :necessite ;
                   rdfs:domain :Opération ;
                   rdfs:range :Maladie ;
                   rdfs:comment "Une opération est nécessaire pour traiter une maladie. Inverse : necessite."@fr ;
                   rdfs:label "est nécessaire pour"@fr .


###  http://example.org/ontologie-medicale#estPrescritePour
:estPrescritePour rdf:type owl:ObjectProperty ;
                  rdfs:domain :Ordonnance ;
                  rdfs:range :Maladie ;
                  rdfs:comment "Une ordonnance est prescrite pour une maladie donnée."@fr ;
                  rdfs:label "est prescrite pour"@fr .


###  http://example.org/ontologie-medicale#estRealiseePar
:estRealiseePar rdf:type owl:ObjectProperty ;
                owl:inverseOf :realise ;
                rdfs:range :Medecin ;
                rdfs:label "est réalisée par"@fr .


###  http://example.org/ontologie-medicale#estSoignePar
:estSoignePar rdf:type owl:ObjectProperty ;
              owl:inverseOf :soigne ;
              rdfs:domain :Patient ;
              rdfs:range :Medecin ;
              rdfs:comment "Un patient est soigné par un médecin. Inverse : soigne."@fr ;
              rdfs:label "est soigné par"@fr .


###  http://example.org/ontologie-medicale#estSymptomeDe
:estSymptomeDe rdf:type owl:ObjectProperty ;
               rdfs:domain :Symptome ;
               rdfs:range :Maladie ;
               rdfs:comment "Un symptôme est associé à une maladie. Inverse : aPourSymptome."@fr ;
               rdfs:label "est symptôme de"@fr .


###  http://example.org/ontologie-medicale#estTraiteePar
:estTraiteePar rdf:type owl:ObjectProperty ;
               owl:inverseOf :traite ;
               rdfs:domain :Maladie ;
               rdfs:range :Medicament ;
               rdfs:comment "Une maladie est traitée par un médicament."@fr ;
               rdfs:label "est traitée par"@fr .


###  http://example.org/ontologie-medicale#est_destinée_à
:est_destinée_à rdf:type owl:ObjectProperty ;
                rdfs:domain :Medecin ;
                rdfs:range :Patient .


###  http://example.org/ontologie-medicale#est_effectuée_par
:est_effectuée_par rdf:type owl:ObjectProperty ;
                   rdfs:domain :Opération ;
                   rdfs:range :Medecin .


###  http://example.org/ontologie-medicale#est_pris_en_charge_par
:est_pris_en_charge_par rdf:type owl:ObjectProperty ;
                        rdfs:domain :Patient .


###  http://example.org/ontologie-medicale#joueLeRôleDe
:joueLeRôleDe rdf:type owl:ObjectProperty ;
              rdfs:domain :Personne ;
              rdfs:range :Role .


###  http://example.org/ontologie-medicale#necessite
:necessite rdf:type owl:ObjectProperty ;
           rdfs:domain :Maladie ;
           rdfs:range :Opération ;
           rdfs:comment "Une maladie nécessite une opération chirurgicale."@fr ;
           rdfs:label "nécessite"@fr .


###  http://example.org/ontologie-medicale#necessiteSuiviPar
:necessiteSuiviPar rdf:type owl:ObjectProperty ;
                   owl:inverseOf :suit ;
                   rdfs:domain :MaladieChronique ;
                   rdfs:range :Medecin ;
                   rdfs:comment "Une maladie chronique nécessite un suivi par un médecin."@fr ;
                   rdfs:label "nécessite suivi par"@fr .


###  http://example.org/ontologie-medicale#numeroCIN
:numeroCIN rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ,
                    owl:InverseFunctionalProperty ;
           rdfs:domain :Personne .


###  http://example.org/ontologie-medicale#participeA
:participeA rdf:type owl:ObjectProperty ;
            rdfs:domain :Patient ;
            rdfs:label "participe à"@fr .


###  http://example.org/ontologie-medicale#peutProvoquer
:peutProvoquer rdf:type owl:ObjectProperty ;
               rdfs:domain :Medicament ;
               rdfs:range :EffetSecondaire ;
               rdfs:label "peut provoquer"@fr .


###  http://example.org/ontologie-medicale#presente
:presente rdf:type owl:ObjectProperty ;
          rdfs:domain :Patient ;
          rdfs:range :Symptome ;
          rdfs:comment "Le patient décrit / présente ses symptômes."@fr ;
          rdfs:label "présente"@fr .


###  http://example.org/ontologie-medicale#provoque
:provoque rdf:type owl:ObjectProperty ;
          rdfs:domain :Maladie ;
          rdfs:range :Symptome ;
          rdfs:label "provoque"@fr .


###  http://example.org/ontologie-medicale#realise
:realise rdf:type owl:ObjectProperty ;
         rdfs:domain :Medecin ;
         rdfs:label "réalise"@fr .


###  http://example.org/ontologie-medicale#redige
:redige rdf:type owl:ObjectProperty ;
        rdfs:domain :Medecin ;
        rdfs:range :Ordonnance ;
        rdfs:label "rédige"@fr .


###  http://example.org/ontologie-medicale#rédige
:rédige rdf:type owl:ObjectProperty ;
        rdfs:domain :Medecin ;
        rdfs:range :Ordonnance .


###  http://example.org/ontologie-medicale#se_déroule_dans
:se_déroule_dans rdf:type owl:ObjectProperty ;
                 rdfs:domain :Opération .


###  http://example.org/ontologie-medicale#soigne
:soigne rdf:type owl:ObjectProperty ;
        rdfs:domain :Medecin ;
        rdfs:range :Patient ;
        rdfs:comment "Un médecin soigne un patient. Inverse : estSoignePar."@fr ;
        rdfs:label "soigne"@fr .


###  http://example.org/ontologie-medicale#souffreDe
:souffreDe rdf:type owl:ObjectProperty ;
           owl:inverseOf :touche ;
           rdfs:domain :Patient ;
           rdfs:range :Maladie ;
           rdfs:comment "Un patient souffre d'une maladie. Inverse : touche."@fr ;
           rdfs:label "souffre de"@fr .


###  http://example.org/ontologie-medicale#subit
:subit rdf:type owl:ObjectProperty ;
       rdfs:domain :Patient ;
       rdfs:range :Opération .


###  http://example.org/ontologie-medicale#suit
:suit rdf:type owl:ObjectProperty ;
      rdfs:domain :Medecin ;
      rdfs:range :MaladieChronique ;
      rdfs:comment "Un médecin suit l'évolution d'une maladie chronique. Inverse : necessiteSuiviPar."@fr ;
      rdfs:label "suit"@fr .


###  http://example.org/ontologie-medicale#touche
:touche rdf:type owl:ObjectProperty ;
        rdfs:domain :Maladie ;
        rdfs:range :Patient ;
        rdfs:comment "Une maladie touche un patient."@fr ;
        rdfs:label "touche"@fr .


###  http://example.org/ontologie-medicale#traite
:traite rdf:type owl:ObjectProperty ;
        rdfs:domain :Medicament ;
        rdfs:range :Maladie ;
        rdfs:comment "Un médicament traite une maladie. Inverse : estTraiteePar."@fr ;
        rdfs:label "traite"@fr .


#################################################################
#    Data properties
#################################################################

###  http://example.org/ontologie-medicale#adresse
:adresse rdf:type owl:DatatypeProperty ;
         rdfs:domain :Personne ;
         rdfs:range xsd:string ;
         rdfs:label "adresse"@fr .


###  http://example.org/ontologie-medicale#age
:age rdf:type owl:DatatypeProperty ,
              owl:FunctionalProperty ;
     rdfs:domain :Personne ;
     rdfs:range xsd:integer ;
     rdfs:comment "Âge de la personne (entier, fonctionnel)."@fr ;
     rdfs:label "âge"@fr .


###  http://example.org/ontologie-medicale#capacité
:capacité rdf:type owl:DatatypeProperty ;
          rdfs:domain :Dossier_patient ;
          rdfs:range xsd:integer .


###  http://example.org/ontologie-medicale#dateConsultation
:dateConsultation rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:date ;
                  rdfs:label "date de la consultation"@fr .


###  http://example.org/ontologie-medicale#dateNaissance
:dateNaissance rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Personne ;
               rdfs:range xsd:date ;
               rdfs:label "date de naissance"@fr .


###  http://example.org/ontologie-medicale#dateOrdonnance
:dateOrdonnance rdf:type owl:DatatypeProperty ;
                rdfs:domain :Ordonnance ;
                rdfs:range xsd:date ;
                rdfs:label "date de l'ordonnance"@fr .


###  http://example.org/ontologie-medicale#description
:description rdf:type owl:DatatypeProperty ;
             rdfs:domain :Maladie ;
             rdfs:range rdf:langString .


###  http://example.org/ontologie-medicale#descriptionSymptome
:descriptionSymptome rdf:type owl:DatatypeProperty .


###  http://example.org/ontologie-medicale#dureeTraitement
:dureeTraitement rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Maladie ;
                 rdfs:range xsd:string ;
                 rdfs:label "duree du traitement"@fr .


###  http://example.org/ontologie-medicale#durée
:durée rdf:type owl:DatatypeProperty ;
       rdfs:domain :Opération ;
       rdfs:range xsd:integer .


###  http://example.org/ontologie-medicale#durée_de_validité
:durée_de_validité rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Ordonnance ;
                   rdfs:range xsd:integer .


###  http://example.org/ontologie-medicale#email
:email rdf:type owl:DatatypeProperty ,
                owl:FunctionalProperty ;
       rdfs:domain :Personne ;
       rdfs:range xsd:string ;
       rdfs:label "e-mail"@fr .


###  http://example.org/ontologie-medicale#estContagieuse
:estContagieuse rdf:type owl:DatatypeProperty ;
                rdfs:domain :Maladie ;
                rdfs:range xsd:boolean .


###  http://example.org/ontologie-medicale#est_urgent
:est_urgent rdf:type owl:DatatypeProperty ;
            rdfs:domain :Opération ;
            rdfs:range xsd:boolean .


###  http://example.org/ontologie-medicale#gravite
:gravite rdf:type owl:DatatypeProperty ;
         rdfs:domain :Maladie ;
         rdfs:range rdf:langString .


###  http://example.org/ontologie-medicale#groupeSanguin
:groupeSanguin rdf:type owl:DatatypeProperty ;
               rdfs:domain :Patient ;
               rdfs:range xsd:string ;
               rdfs:label "groupe sanguin"@fr .


###  http://example.org/ontologie-medicale#intensite
:intensite rdf:type owl:DatatypeProperty .


###  http://example.org/ontologie-medicale#nom
:nom rdf:type owl:DatatypeProperty ;
     rdfs:domain :Personne ;
     rdfs:range xsd:string ;
     rdfs:label "nom"@fr .


###  http://example.org/ontologie-medicale#nom_du_service
:nom_du_service rdf:type owl:DatatypeProperty ;
                rdfs:range xsd:string .


###  http://example.org/ontologie-medicale#numeroCIN
:numeroCIN rdf:type owl:DatatypeProperty ,
                    owl:FunctionalProperty ;
           rdfs:range xsd:string .


###  http://example.org/ontologie-medicale#numeroDossier
:numeroDossier rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :Patient ;
               rdfs:range xsd:string ;
               rdfs:label "numéro de dossier"@fr .


###  http://example.org/ontologie-medicale#numeroOrdre
:numeroOrdre rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Medecin ;
             rdfs:range xsd:string ;
             rdfs:comment "Numéro d'ordre professionnel du médecin."@fr ;
             rdfs:label "numéro d'ordre"@fr .


###  http://example.org/ontologie-medicale#numéro_de_salle
:numéro_de_salle rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Dossier_patient ;
                 rdfs:range xsd:integer .


###  http://example.org/ontologie-medicale#posologie
:posologie rdf:type owl:DatatypeProperty ;
           rdfs:domain :Medicament ;
           rdfs:range xsd:string ;
           rdfs:label "posologie"@fr .


###  http://example.org/ontologie-medicale#prenom
:prenom rdf:type owl:DatatypeProperty ,
                 owl:FunctionalProperty ;
        rdfs:domain :Personne ;
        rdfs:range xsd:string ;
        rdfs:label "prénom"@fr .


###  http://example.org/ontologie-medicale#sexe
:sexe rdf:type owl:DatatypeProperty ;
      rdfs:domain :Patient ;
      rdfs:range xsd:string ;
      rdfs:label "sexe"@fr .


###  http://example.org/ontologie-medicale#specialite
:specialite rdf:type owl:DatatypeProperty ;
            rdfs:domain :MedecinSpecialiste ;
            rdfs:range xsd:string ;
            rdfs:label "spécialité"@fr .


###  http://example.org/ontologie-medicale#tarif
:tarif rdf:type owl:DatatypeProperty ;
       rdfs:domain :Consultation ;
       rdfs:range xsd:decimal .


###  http://example.org/ontologie-medicale#temperature
:temperature rdf:type owl:DatatypeProperty .


###  http://example.org/ontologie-medicale#téléphone
:téléphone rdf:type owl:DatatypeProperty ;
           rdfs:domain :Personne ;
           rdfs:range xsd:string .


###  http://example.org/ontologie-medicale#date_de_l’opération
ns1:opération rdf:type owl:DatatypeProperty ;
              rdfs:domain :Opération ;
              rdfs:range xsd:date .


###  http://example.org/ontologie-medicale#date_de_l’ordonnance
ns1:ordonnance rdf:type owl:DatatypeProperty ;
               rdfs:domain :Ordonnance ;
               rdfs:range xsd:date .


###  http://example.org/ontologie-medicale#numéro_de_l’ordonnance
<http://example.org/ontologie-medicale#numéro_de_l’ordonnance> rdf:type owl:DatatypeProperty ;
                                                               rdfs:domain :Ordonnance ;
                                                               rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://example.org/ontologie-medicale#Agents_de_service_hospitalier
:Agents_de_service_hospitalier rdf:type owl:Class ;
                               rdfs:subClassOf :Stuff_Médicale .


###  http://example.org/ontologie-medicale#Aide_soignant
:Aide_soignant rdf:type owl:Class ;
               rdfs:subClassOf :Stuff_Médicale .


###  http://example.org/ontologie-medicale#Anesthésiste
:Anesthésiste rdf:type owl:Class ;
              rdfs:subClassOf :MedecinSpecialiste .


###  http://example.org/ontologie-medicale#Antalgique
:Antalgique rdf:type owl:Class ;
            rdfs:subClassOf :Medicament ;
            rdfs:label "Antalgique"@fr .


###  http://example.org/ontologie-medicale#AntiInflammatoire
:AntiInflammatoire rdf:type owl:Class ;
                   rdfs:subClassOf :Medicament ;
                   rdfs:label "Anti-inflammatoire"@fr .


###  http://example.org/ontologie-medicale#Antibiotique
:Antibiotique rdf:type owl:Class ;
              rdfs:subClassOf :Medicament ;
              rdfs:label "Antibiotique"@fr .


###  http://example.org/ontologie-medicale#Cardiologue
:Cardiologue rdf:type owl:Class ;
             rdfs:subClassOf :MedecinSpecialiste .


###  http://example.org/ontologie-medicale#Consultation
:Consultation rdf:type owl:Class ;
              rdfs:subClassOf :Service_medicale .


###  http://example.org/ontologie-medicale#ConsultationControle
:ConsultationControle rdf:type owl:Class ;
                      rdfs:subClassOf :Consultation .


###  http://example.org/ontologie-medicale#ConsultationGenerale
:ConsultationGenerale rdf:type owl:Class ;
                      rdfs:subClassOf :Consultation .


###  http://example.org/ontologie-medicale#ConsultationSpecialisee
:ConsultationSpecialisee rdf:type owl:Class ;
                         rdfs:subClassOf :Consultation .


###  http://example.org/ontologie-medicale#ConsultationUrgence
:ConsultationUrgence rdf:type owl:Class ;
                     rdfs:subClassOf :Consultation .


###  http://example.org/ontologie-medicale#Dermatologue
:Dermatologue rdf:type owl:Class ;
              rdfs:subClassOf :MedecinSpecialiste .


###  http://example.org/ontologie-medicale#Dossier_medicale
:Dossier_medicale rdf:type owl:Class ;
                  rdfs:subClassOf :Dossier_patient .


###  http://example.org/ontologie-medicale#Dossier_patient
:Dossier_patient rdf:type owl:Class ;
                 rdfs:subClassOf :Service_administratif .


###  http://example.org/ontologie-medicale#EffetDigestif
:EffetDigestif rdf:type owl:Class ;
               rdfs:subClassOf :EffetSecondaire ;
               rdfs:label "Effet secondaire digestif"@fr .


###  http://example.org/ontologie-medicale#EffetNeurologique
:EffetNeurologique rdf:type owl:Class ;
                   rdfs:subClassOf :EffetSecondaire ;
                   rdfs:label "Effet secondaire neurologique"@fr .


###  http://example.org/ontologie-medicale#EffetSecondaire
:EffetSecondaire rdf:type owl:Class ;
                 rdfs:subClassOf :Medicament ;
                 rdfs:label "Effet secondaire"@fr .


###  http://example.org/ontologie-medicale#Endocrinologue
:Endocrinologue rdf:type owl:Class ;
                rdfs:subClassOf :MedecinSpecialiste .


###  http://example.org/ontologie-medicale#Facturation
:Facturation rdf:type owl:Class ;
             rdfs:subClassOf :Service_administratif .


###  http://example.org/ontologie-medicale#Facture
:Facture rdf:type owl:Class ;
         rdfs:subClassOf :Paiement .


###  http://example.org/ontologie-medicale#Fievre
:Fievre rdf:type owl:Class .


###  http://example.org/ontologie-medicale#Gastro-entérologue
:Gastro-entérologue rdf:type owl:Class ;
                    rdfs:subClassOf :MedecinSpecialiste .


###  http://example.org/ontologie-medicale#Ibuprofene
:Ibuprofene rdf:type owl:Class ;
            rdfs:subClassOf :AntiInflammatoire ;
            rdfs:label "Ibuprofène"@fr .


###  http://example.org/ontologie-medicale#Maladie
:Maladie rdf:type owl:Class ;
         rdfs:label "Maladie"@fr .


###  http://example.org/ontologie-medicale#MaladieChronique
:MaladieChronique rdf:type owl:Class ;
                  rdfs:subClassOf :Type ;
                  rdfs:label "Maladie chronique"@fr .


###  http://example.org/ontologie-medicale#MaladieDigestive
:MaladieDigestive rdf:type owl:Class ;
                  rdfs:subClassOf :Type ;
                  rdfs:label "Maladie digestive"@fr .


###  http://example.org/ontologie-medicale#MaladieInfectieuse
:MaladieInfectieuse rdf:type owl:Class ;
                    rdfs:subClassOf :Type ;
                    rdfs:label "Maladie infectieuse"@fr .


###  http://example.org/ontologie-medicale#Medecin
:Medecin rdf:type owl:Class ;
         rdfs:subClassOf :Role ;
         owl:disjointWith :Patient ;
         rdfs:label "Médecin"@fr .


###  http://example.org/ontologie-medicale#MedecinActif
:MedecinActif rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Medecin
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :realise ;
                                                           owl:someValuesFrom :Consultation
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:comment "Classe definie: Medecin qui realise au moins une Consultation."@fr ;
              rdfs:label "Medecin actif"@fr .


