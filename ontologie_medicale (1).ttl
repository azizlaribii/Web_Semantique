med:MedecinActif a owl:Class ;
    rdfs:label "Medecin actif"@fr ;
    rdfs:comment "Classe definie: Medecin qui realise au moins une Consultation."@fr ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( med:Medecin [ a owl:Restriction ;
                        owl:onProperty med:realise ;
                        owl:someValuesFrom med:Consultation ] ) ] .

