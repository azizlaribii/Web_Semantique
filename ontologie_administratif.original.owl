  <rdfs:domain rdf:resource="#Rembourcement_Assurance"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomAssurance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Assurance"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tauxCouverture">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Assurance"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Service_administratif">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Dossier_patient">
  <rdfs:subClassOf rdf:resource="#Service_administratif"/>
</owl:Class>

<owl:Class rdf:about="#Dossier_medicale">
  <rdfs:subClassOf rdf:resource="#Dossier_patient"/>
  <owl:disjointWith rdf:resource="#Rendez_vous"/>
</owl:Class>

<owl:Class rdf:about="#Rendez_vous">
  <rdfs:subClassOf rdf:resource="#Dossier_patient"/>
</owl:Class>

<owl:Class rdf:about="#Facturation">
  <rdfs:subClassOf rdf:resource="#Service_administratif"/>
</owl:Class>

<owl:Class rdf:about="#Facture">
  <rdfs:subClassOf rdf:resource="#Facturation"/>
</owl:Class>

<owl:Class rdf:about="#Paiement">
  <rdfs:subClassOf rdf:resource="#Facturation"/>
</owl:Class>

<owl:Class rdf:about="#Rembourcement_Assurance">
  <rdfs:subClassOf rdf:resource="#Facturation"/>
</owl:Class>

<owl:Class rdf:about="#Assurance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RendezVousAnnule">
  <rdfs:subClassOf rdf:resource="#Rendez_vous"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rendez_vous"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#statutRDV"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Annule</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#RendezVousConfirme">
  <rdfs:subClassOf rdf:resource="#Rendez_vous"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Rendez_vous"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#statutRDV"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confirme</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#DossierActif">
  <rdfs:subClassOf rdf:resource="#Dossier_patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Dossier_patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#statutDossier"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actif</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FacturePayee">
  <rdfs:subClassOf rdf:resource="#Facture"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Facture"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#estReglePar"/>
          <owl:someValuesFrom rdf:resource="#Paiement"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#FactureRembourseeParAssurance">
  <rdfs:subClassOf rdf:resource="#Facture"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Facture"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#estRembourseePar"/>
          <owl:someValuesFrom rdf:resource="#Rembourcement_Assurance"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#PatientAssure">
  <rdfs:subClassOf rdf:resource="http://example.org/ontologie-medicale#Patient"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://example.org/ontologie-medicale#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#estCouvertPar"/>
          <owl:someValuesFrom rdf:resource="#Assurance"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

