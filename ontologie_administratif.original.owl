<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/ontologie-administratif"
         xmlns="http://example.org/ontologie-administratif#">

<owl:Ontology rdf:about="http://example.org/ontologie-administratif"/>

<owl:ObjectProperty rdf:about="#concernePatient">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Dossier_patient"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-medicale#Patient"/>
  <owl:inverseOf rdf:resource="#aPourDossier"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#facturePourPatient">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Facture"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-medicale#Patient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPourDossier">
  <rdfs:domain rdf:resource="http://example.org/ontologie-medicale#Patient"/>
  <rdfs:range rdf:resource="#Dossier_patient"/>
  <owl:inverseOf rdf:resource="#concernePatient"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#avecMedecin">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Rendez_vous"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-medicale#Medecin"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#contientConsultation">
  <rdfs:domain rdf:resource="#Dossier_medicale"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-medicale#Consultation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#concerneRendezVous">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Facture"/>
  <rdfs:range rdf:resource="#Rendez_vous"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estReglePar">
  <rdfs:domain rdf:resource="#Facture"/>
  <rdfs:range rdf:resource="#Paiement"/>
  <owl:inverseOf rdf:resource="#reglePourFacture"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#reglePourFacture">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Paiement"/>
  <rdfs:range rdf:resource="#Facture"/>
  <owl:inverseOf rdf:resource="#estReglePar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estRembourseePar">
  <rdfs:domain rdf:resource="#Facture"/>
  <rdfs:range rdf:resource="#Rembourcement_Assurance"/>
  <owl:inverseOf rdf:resource="#rembourseFacture"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#rembourseFacture">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Rembourcement_Assurance"/>
  <rdfs:range rdf:resource="#Facture"/>
  <owl:inverseOf rdf:resource="#estRembourseePar"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#verseePar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Rembourcement_Assurance"/>
  <rdfs:range rdf:resource="#Assurance"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estCouvertPar">
  <rdfs:domain rdf:resource="http://example.org/ontologie-medicale#Patient"/>
  <rdfs:range rdf:resource="#Assurance"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#numeroDossierAdm">
