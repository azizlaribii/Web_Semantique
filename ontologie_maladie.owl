</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Grippe_Saisonniere">
  <rdf:type rdf:resource="#Grippe"/>
  <aPourSymptome rdf:resource="#Fatigue"/>
  <aPourSymptome rdf:resource="#Toux"/>
  <aPourSymptome rdf:resource="#Fievre"/>
  <estTraiteePar rdf:resource="#Paracetamol"/>
  <estTraiteePar rdf:resource="#Ibuprofene"/>
  <touche rdf:resource="#Karim_Patient"/>
  <concerneMaladie rdf:resource="#Ordonnance_Grippe"/>
  <aPourAgentPathogene rdf:resource="#Virus_Influenza"/>
  <rdf:type rdf:resource="#MaladieTraitee"/>
  <nom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grippe saisonniere</nom>
  <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie infectieuse respiratoire causee par le virus Influenza.</description>
  <estContagieuse rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estContagieuse>
  <estChronique rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estChronique>
  <gravite rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</gravite>
  <dureeTraitement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">7 jours</dureeTraitement>
  <codeCIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J11</codeCIM>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Angine_Streptocoque">
  <rdf:type rdf:resource="#Angine"/>
  <aPourSymptome rdf:resource="#Maux_de_gorge"/>
  <aPourSymptome rdf:resource="#Fievre"/>
  <estTraiteePar rdf:resource="#Amoxicilline"/>
  <touche rdf:resource="#Leila_Patient"/>
  <aPourAgentPathogene rdf:resource="#Streptocoque_Pyogenes"/>
  <rdf:type rdf:resource="#MaladieTraitee"/>
  <nom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Angine streptocoque</nom>
  <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infection bacterienne des amygdales.</description>
  <estContagieuse rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estContagieuse>
  <estChronique rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estChronique>
  <gravite rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</gravite>
  <dureeTraitement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 jours</dureeTraitement>
  <codeCIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">J03</codeCIM>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Diabete_Type2">
  <rdf:type rdf:resource="#Diabete"/>
  <aPourSymptome rdf:resource="#Fatigue"/>
  <aPourSymptome rdf:resource="#Soif_excessive"/>
  <estTraiteePar rdf:resource="#Metformine"/>
  <touche rdf:resource="#Karim_Patient"/>
  <necessiteSuiviPar rdf:resource="#Dr_Ali_Maladie"/>
  <concerneMaladie rdf:resource="#Ordonnance_Diabete"/>
  <rdf:type rdf:resource="#MaladieTraitee"/>
  <rdf:type rdf:resource="#MaladieAvecSuivi"/>
  <nom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabete de type 2</nom>
  <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie chronique due a un defaut d'utilisation de l'insuline.</description>
  <estContagieuse rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estContagieuse>
  <estChronique rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</estChronique>
  <gravite rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</gravite>
  <dureeTraitement rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Traitement a vie</dureeTraitement>
  <codeCIM rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E11</codeCIM>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Hypertension_Arterielle">
  <rdf:type rdf:resource="#Hypertension"/>
  <aPourSymptome rdf:resource="#Cephalee"/>
  <aPourSymptome rdf:resource="#Fatigue"/>
  <estTraiteePar rdf:resource="#Amlodipine"/>
  <touche rdf:resource="#Leila_Patient"/>
  <necessiteSuiviPar rdf:resource="#Dr_Sonia_Maladie"/>
  <rdf:type rdf:resource="#MaladieTraitee"/>
  <rdf:type rdf:resource="#MaladieAvecSuivi"/>
  <nom rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypertension arterielle</nom>
  <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pression arterielle anormalement elevee.</description>
  <estContagieuse rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</estContagieuse>
