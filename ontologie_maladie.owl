<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/ontologie-maladie"
         xmlns="http://example.org/ontologie-maladie#">

<owl:Ontology rdf:about="http://example.org/ontologie-maladie"/>

<owl:ObjectProperty rdf:about="#aPourSymptome">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Symptome"/>
  <owl:inverseOf rdf:resource="#estSymptomeDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a pour symptome</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estSymptomeDe">
  <rdfs:domain rdf:resource="#Symptome"/>
  <rdfs:range rdf:resource="#Maladie"/>
  <owl:inverseOf rdf:resource="#aPourSymptome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est symptome de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estTraiteePar">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Medicament"/>
  <owl:inverseOf rdf:resource="#traite"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est traitee par</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#traite">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#Maladie"/>
  <owl:inverseOf rdf:resource="#estTraiteePar"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">traite</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#touche">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Patient"/>
  <owl:inverseOf rdf:resource="#souffreDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">touche</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#souffreDe">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Maladie"/>
  <owl:inverseOf rdf:resource="#touche"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">souffre de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#necessite">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Operation"/>
  <owl:inverseOf rdf:resource="#estNecessairePour"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">necessite</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estNecessairePour">
  <rdfs:domain rdf:resource="#Operation"/>
  <rdfs:range rdf:resource="#Maladie"/>
  <owl:inverseOf rdf:resource="#necessite"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est necessaire pour</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estPrescritePour">
  <rdfs:domain rdf:resource="#Ordonnance"/>
  <rdfs:range rdf:resource="#Maladie"/>
  <owl:inverseOf rdf:resource="#concerneMaladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est prescrite pour</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#concerneMaladie">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Ordonnance"/>
  <owl:inverseOf rdf:resource="#estPrescritePour"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">concerne maladie</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#necessiteSuiviPar">
  <rdfs:domain rdf:resource="#MaladieChronique"/>
  <rdfs:range rdf:resource="#Medecin"/>
  <owl:inverseOf rdf:resource="#suit"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">necessite suivi par</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#suit">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#MaladieChronique"/>
  <owl:inverseOf rdf:resource="#necessiteSuiviPar"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">suit</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aPourAgentPathogene">
  <rdfs:domain rdf:resource="#MaladieInfectieuse"/>
  <rdfs:range rdf:resource="#AgentPathogene"/>
  <owl:inverseOf rdf:resource="#causeMaladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a pour agent pathogene</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#causeMaladie">
  <rdfs:domain rdf:resource="#AgentPathogene"/>
  <rdfs:range rdf:resource="#MaladieInfectieuse"/>
  <owl:inverseOf rdf:resource="#aPourAgentPathogene"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cause maladie</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#provoque">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="#Symptome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">provoque</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#description">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#estContagieuse">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#estChronique">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#gravite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dureeTraitement">
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#codeCIM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Maladie"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomSymptome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Symptome"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Maladie">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toute affection pathologique dans le systeme medical.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MaladieInfectieuse">
  <rdfs:subClassOf rdf:resource="#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie infectieuse</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MaladieChronique">
  <rdfs:subClassOf rdf:resource="#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie chronique</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MaladieDigestive">
  <rdfs:subClassOf rdf:resource="#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie digestive</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Grippe">
  <rdfs:subClassOf rdf:resource="#MaladieInfectieuse"/>
  <owl:disjointWith rdf:resource="#Angine"/>
</owl:Class>

<owl:Class rdf:about="#Angine">
  <rdfs:subClassOf rdf:resource="#MaladieInfectieuse"/>
</owl:Class>

<owl:Class rdf:about="#Diabete">
  <rdfs:subClassOf rdf:resource="#MaladieChronique"/>
  <owl:disjointWith rdf:resource="#Hypertension"/>
</owl:Class>

<owl:Class rdf:about="#Hypertension">
  <rdfs:subClassOf rdf:resource="#MaladieChronique"/>
</owl:Class>

<owl:Class rdf:about="#UlcereGastrique">
  <rdfs:subClassOf rdf:resource="#MaladieDigestive"/>
</owl:Class>

<owl:Class rdf:about="#Symptome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Symptome</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#SymptomeGeneral">
  <rdfs:subClassOf rdf:resource="#Symptome"/>
</owl:Class>

<owl:Class rdf:about="#SymptomeRespiratoire">
  <rdfs:subClassOf rdf:resource="#Symptome"/>
</owl:Class>

<owl:Class rdf:about="#SymptomeDigestif">
  <rdfs:subClassOf rdf:resource="#Symptome"/>
</owl:Class>

<owl:Class rdf:about="#Medicament">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Ordonnance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Operation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Medecin">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Patient">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AgentPathogene">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agent pathogene</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Virus">
  <rdfs:subClassOf rdf:resource="#AgentPathogene"/>
  <owl:disjointWith rdf:resource="#Bacterie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Virus</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Bacterie">
  <rdfs:subClassOf rdf:resource="#AgentPathogene"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bacterie</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MaladieGrave">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Maladie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#necessite"/>
          <owl:someValuesFrom rdf:resource="#Operation"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie grave</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie : Maladie necessitant une Operation.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MaladieAvecSuivi">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#MaladieChronique"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#necessiteSuiviPar"/>
          <owl:someValuesFrom rdf:resource="#Medecin"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#MaladieChronique"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie avec suivi</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie : MaladieChronique avec suivi Medecin.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MaladieTraitee">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Maladie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#estTraiteePar"/>
          <owl:someValuesFrom rdf:resource="#Medicament"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maladie traitee</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie : Maladie traitee par un Medicament.</rdfs:comment>
</owl:Class>

