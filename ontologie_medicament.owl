<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/ontologie-medicament"
         xmlns="http://example.org/ontologie-medicament#">

<owl:Ontology rdf:about="http://example.org/ontologie-medicament"/>

<owl:ObjectProperty rdf:about="#contientMolecule">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#Molecule"/>
  <owl:inverseOf rdf:resource="#estPrincipeActifDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">contient molecule</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estPrincipeActifDe">
  <rdfs:domain rdf:resource="#Molecule"/>
  <rdfs:range rdf:resource="#Medicament"/>
  <owl:inverseOf rdf:resource="#contientMolecule"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est principe actif de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#peutProvoquer">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#EffetSecondaire"/>
  <owl:inverseOf rdf:resource="#estProvoquePar"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">peut provoquer</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estProvoquePar">
  <rdfs:domain rdf:resource="#EffetSecondaire"/>
  <rdfs:range rdf:resource="#Medicament"/>
  <owl:inverseOf rdf:resource="#peutProvoquer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est provoque par</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#traite">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-maladie#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">traite</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estContreIndiquePour">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://example.org/ontologie-maladie#Maladie"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est contre-indique pour</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estContreIndiqueEn">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#ConditionClinique"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est contre-indique en cas de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#interagitAvec">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">interagit avec</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#impliqueMedicament">
  <rdfs:domain rdf:resource="#InteractionMedicamenteuse"/>
  <rdfs:range rdf:resource="#Medicament"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evalue">
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="#Medicament"/>
  <owl:inverseOf rdf:resource="#estEvaluePar"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">evalue</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estEvaluePar">
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="#EssaiClinique"/>
  <owl:inverseOf rdf:resource="#evalue"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est evalue par</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aObserveEffet">
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="#EffetSecondaire"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a observe l'effet</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nomCommercial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dosage">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#formeGalenique">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#voieAdministration">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#posologie">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#codeATC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#prixTND">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#necessiteOrdonnance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medicament"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomMolecule">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Molecule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#formuleBrute">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Molecule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#masseMolaire">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Molecule"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomEffet">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EffetSecondaire"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#frequence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EffetSecondaire"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#graviteEffet">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EffetSecondaire"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nomCondition">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ConditionClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#niveauRisque">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#InteractionMedicamenteuse"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#descriptionInteraction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#InteractionMedicamenteuse"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#phase">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nombrePatients">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tauxEfficacite">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#anneeEssai">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#objectifEssai">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#EssaiClinique"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Medicament">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#contientMolecule"/>
      <owl:someValuesFrom rdf:resource="#Molecule"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medicament</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Produit pharmaceutique commercialise, contenant au moins une molecule active.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Antalgique">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antalgique</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AntiInflammatoire">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-inflammatoire</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Antibiotique">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antibiotique</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Antidiabetique">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antidiabetique</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Antihypertenseur">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Antihypertenseur</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#AntiUlcereux">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-ulcereux</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Anticoagulant">
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anticoagulant</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Molecule">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Molecule</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Principe actif contenu dans un medicament.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EffetSecondaire">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effet secondaire</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effet indesirable pouvant etre provoque par un medicament.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EffetDigestif">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetNeurologique">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetCutane">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetCardiovasculaire">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetHepatique">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetHematologique">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#EffetMetabolique">
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
</owl:Class>

<owl:Class rdf:about="#ConditionClinique">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Condition clinique</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Situation du patient qui contre-indique un medicament (grossesse, allergie, ...).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InteractionMedicamenteuse">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Interaction medicamenteuse</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#EssaiClinique">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Essai clinique</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Donnees cliniques evaluant un medicament (valeurs pedagogiques fictives).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EffetGrave">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#EffetSecondaire"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#graviteEffet"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#EffetSecondaire"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Effet grave</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie : EffetSecondaire dont la gravite vaut 3.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MedicamentARisque">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medicament"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#peutProvoquer"/>
          <owl:someValuesFrom rdf:resource="#EffetGrave"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medicament a risque</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie : Medicament pouvant provoquer un EffetGrave.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MedicamentSurOrdonnance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medicament"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#necessiteOrdonnance"/>
          <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medicament sur ordonnance</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#MedicamentEvalueCliniquement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medicament"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#estEvaluePar"/>
          <owl:someValuesFrom rdf:resource="#EssaiClinique"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="#Medicament"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medicament evalue cliniquement</rdfs:label>
</owl:Class>

