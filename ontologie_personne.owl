<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/ontologie-medicale"
         xmlns="http://example.org/ontologie-medicale#">

<owl:Ontology rdf:about="http://example.org/ontologie-medicale"/>

<owl:ObjectProperty rdf:about="#joueLeRoleDe">
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">joue le role de</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estSoignePar">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Medecin"/>
  <owl:inverseOf rdf:resource="#soigne"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">est soigne par</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#soigne">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Patient"/>
  <owl:inverseOf rdf:resource="#estSoignePar"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">soigne</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#connait">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="#Personne"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">connait</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#aConsulte">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="#Personne"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">a consulte</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#presente">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Symptome"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presente</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#realise">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Consultation"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#redige">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Ordonnance"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#diagnostique">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Maladie"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#appartientA">
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="#Service"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#estPrisEnChargePar">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="#Service"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#nom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nom</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#prenom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#age">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">age</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dateNaissance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#telephone">
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#email">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#adresse">
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numeroCIN">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
  <rdfs:domain rdf:resource="#Personne"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">numero CIN</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specialite">
  <rdfs:domain rdf:resource="#MedecinSpecialiste"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numeroOrdre">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Medecin"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#groupeSanguin">
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">groupe sanguin</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#numeroDossier">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Patient"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">numero de dossier</rdfs:label>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Personne">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Personne</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Toute entite humaine dans le systeme medical.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Role">
  <rdfs:subClassOf rdf:resource="#Personne"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Medecin">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <owl:disjointWith rdf:resource="#Patient"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medecin</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Professionnel de sante autorise a pratiquer la medecine.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MedecinGeneraliste">
  <rdfs:subClassOf rdf:resource="#Medecin"/>
  <owl:disjointWith rdf:resource="#MedecinSpecialiste"/>
</owl:Class>

<owl:Class rdf:about="#MedecinSpecialiste">
  <rdfs:subClassOf rdf:resource="#Medecin"/>
</owl:Class>

<owl:Class rdf:about="#Cardiologue">
  <rdfs:subClassOf rdf:resource="#MedecinSpecialiste"/>
</owl:Class>

<owl:Class rdf:about="#Patient">
  <rdfs:subClassOf rdf:resource="#Role"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Personne recevant des soins medicaux.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PatientAdulte">
  <rdfs:subClassOf rdf:resource="#Patient"/>
  <owl:disjointWith rdf:resource="#PatientEnfant"/>
</owl:Class>

<owl:Class rdf:about="#PatientEnfant">
  <rdfs:subClassOf rdf:resource="#Patient"/>
</owl:Class>

<owl:Class rdf:about="#Stagiaire">
  <rdfs:subClassOf rdf:resource="#Role"/>
</owl:Class>

<owl:Class rdf:about="#Stuff_Medicale">
  <rdfs:subClassOf rdf:resource="#Role"/>
</owl:Class>

<owl:Class rdf:about="#Infirmier">
  <rdfs:subClassOf rdf:resource="#Stuff_Medicale"/>
</owl:Class>

<owl:Class rdf:about="#Maladie">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MaladieInfectieuse">
  <rdfs:subClassOf rdf:resource="#Maladie"/>
</owl:Class>

<owl:Class rdf:about="#Symptome">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Service">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Ordonnance">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Consultation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#MedecinActif">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Medecin"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#realise"/>
          <owl:someValuesFrom rdf:resource="#Consultation"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Medecin actif</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie (Medecin qui realise au moins une Consultation).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PatientEnregistre">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Patient"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#numeroDossier"/>
          <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Patient enregistre</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Classe definie (Patient qui possede un numero de dossier).</rdfs:comment>
</owl:Class>

