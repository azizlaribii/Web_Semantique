  <rdf:Description rdf:about="http://example.org/ontologie-medicale#Migraine">
    <rdf:type rdf:resource="http://example.org/ontologie-medicale#Maladie"/>
    <rdf:type rdf:resource="http://example.org/ontologie-medicale#MaladieChronique"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label>Migraine</rdfs:label>
    <rdfs:label xml:lang="fr">Migraine</rdfs:label>
    <med:aPourSymptome rdf:resource="http://example.org/ontologie-medicale#Maux_de_tete"/>
    <med:aPourSymptome rdf:resource="http://example.org/ontologie-medicale#Nausee"/>
    <med:aPourSymptome rdf:resource="http://example.org/ontologie-medicale#Vomissement_Symp"/>
    <med:description xml:lang="fr">Maux de tete intenses et recurrents souvent accompagnes de nausees.</med:description>
    <med:dureeTraitement>Traitement de la crise</med:dureeTraitement>
